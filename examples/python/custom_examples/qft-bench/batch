#!/bin/bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --job-name=testcunqa
#SBATCH --partition=lusitania
#SBATCH --output=salida_%j.txt
#SBATCH --error=error_%j.txt

#SBATCH --mail-user=jesus.cerrudo@computaex.es
#SBATCH --mail-type=END,FAIL

# --- 1. DEFINICIÓN DE EJECUTABLES (La clave del éxito) ---
# Usamos tu ruta absoluta para que nadie pueda cambiarla
MI_PYTHON="/lusitania_homes/CenitS/jesus.cerrudo/.conda/envs/cunqa-bench/bin/python"

# --- 2. ENTORNO DEL SISTEMA ---
# Cargamos solo librerías base (compiladores, MPI), NADA de Python del sistema
module purge
module load gcc/gcc-11.2.0 cmake/cmake-3.23 openblas/openblas-0.3.24 openmpi/openmpi-4.1.2-gcc11.2.0 libraries/libffi-devel-8.1

# --- 3. CONFIGURACIÓN DEL PUENTE CUNQA ---
CUNQA_ROOT="/lusitania_apps/python/python-3.10-cunqa-ex"

# A) PYTHONPATH: Para que 'MI_PYTHON' pueda importar 'cunqa'
export PYTHONPATH="${CUNQA_ROOT}/lib/python3.10/site-packages:${PYTHONPATH}"

# B) LD_LIBRARY_PATH: Para que las herramientas de CUNQA (escritas en C/C++) encuentren sus librerías .so
export LD_LIBRARY_PATH="${CUNQA_ROOT}/lib:${LD_LIBRARY_PATH}"

# C) PATH: Para que si el script llama a 'qraise' o 'setup_qpus', el sistema los encuentre
export PATH="${PATH}:${CUNQA_ROOT}/bin"

# --- 4. VERIFICACIONES DE SEGURIDAD ---
echo "--- DIAGNÓSTICO ---"
echo "Ejecutando en: $(hostname)"
echo "Usando Python explícito: $MI_PYTHON"

# Verificar si psutil (de conda) y cunqa (del sistema) son visibles a la vez
$MI_PYTHON -c "import psutil; print('OK: psutil cargado (Conda)')" || echo "ERROR CRÍTICO: psutil no carga"
$MI_PYTHON -c "import cunqa; print('OK: CUNQA cargado (Sistema)')" || echo "ERROR CRÍTICO: CUNQA no carga"

# --- 5. EJECUCIÓN ---
echo "--- LANZANDO SCRIPT ---"
# Usamos la ruta completa, no 'python'
$MI_PYTHON -u cunqa_main.py "3-26" 1024 --nodes 8 --qpus-per-node 15 --mem-per-qpu 2 --cores 1

echo "--- FIN ---"
