import os
from pathlib import Path

# Ruta estática global
CUNQA_PATH = "@CUNQA_FULL_DATA_PATH@"
INSTALL_PATH = "@CMAKE_INSTALL_PREFIX@"

# Rutas dinámicas locales (Sincronizadas con C++ para HPC)
_STORE_DIR = os.getenv("STORE")
if _STORE_DIR:
    _CUNQA_USER_DIR = Path(_STORE_DIR) / ".cunqa"
else:
    _CUNQA_USER_DIR = Path.home() / ".cunqa"

# Rutas finales
QPUS_FILEPATH = str(_CUNQA_USER_DIR / "qpus.json")
COMM_FILEPATH = str(_CUNQA_USER_DIR / "communications.json")

# Librerías dinámicas
LIBS_DIR = str(Path(INSTALL_PATH) / "lib")

REMOTE_GATES = ["send", "recv", "qsend", "qrecv", "expose", "rcontrol"]